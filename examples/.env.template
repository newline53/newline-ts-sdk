# newline-ts-sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: NEWLINE_
#
# Security environment variables:
NEWLINE_PROGRAM_UID=your_programuid_here
NEWLINE_HMAC_KEY=your_hmackey_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
NEWLINE_DEBUG=true
